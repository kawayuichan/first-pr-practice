          ],
          "value": 1200
        },
        {
          "label": "1個あたりの貢献利益(販売単価 − 変動費)",
          "op": "sub",
          "args": [
            2000,
            1200
          ],
          "value": 800
        },
        {
          "label": "貢献利益 × 100",
          "op": "mul",
          "args": [
            800,
            100
          ],
          "value": 80000
        },
        {
          "label": "貢献利益率(%)(÷ 販売単価)",
          "op": "div",
          "args": [
            80000,
            2000
          ],
          "value": 40
        }
      ],
      "explanation": "1個あたりの変動費は ¥1,100 + ¥100 = ¥1,200、貢献利益は ¥2,000 − ¥1,200 = ¥800。¥800 ÷ ¥2,000 = 40%。",
      "mistakes": [
        {
          "value": 60,
          "calc": [
            {
              "label": "1個あたりの変動費(変動製造原価 + 変動販売費)",
