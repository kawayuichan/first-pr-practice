              "args": [
                1100,
                100
              ],
              "value": 1200
            },
            {
              "label": "誤答: 変動費 × 100",
              "op": "mul",
              "args": [
                1200,
                100
              ],
              "value": 120000
            },
            {
              "label": "誤答: 変動費率(%)",
              "op": "div",
              "args": [
                120000,
