    {
      "id": "K08-001",
      "topic": "K08",
      "format": "basic_check",
      "type": "numeric",
      "difficulty": 1,
      "prompt": "月末仕掛品は 300個、加工進捗度は 40% である。加工費の計算に使う月末仕掛品の完成品換算量は何個か。",
      "unit": "個",
      "answer": 120,
      "calc": [
        {
          "label": "月末仕掛品の数量 × 加工進捗度(%)",
          "op": "mul",
          "args": [
            300,
            40
          ],
          "value": 12000
        },
        {
          "label": "完成品換算量(÷ 100)",
          "op": "div",
          "args": [
            12000,
            100
          ],
          "value": 120
        }
      ],
      "explanation": "完成品換算量 = 数量 × 加工進捗度 = 300個 × 40% = 120個。",
      "mistakes": [
        {
          "value": 180,
          "calc": [
            {
              "label": "誤答: 残りの割合(100% − 進捗度)",
              "op": "sub",
              "args": [
                100,
                40
              ],
              "value": 60
            },
            {
              "label": "誤答: 数量 × 残りの割合",
              "op": "mul",
              "args": [
                300,
                60
              ],
              "value": 18000
            },
            {
              "label": "誤答: 残りの割合で計算した換算量(÷ 100)",
              "op": "div",
              "args": [
                18000,
                100
              ],
              "value": 180
            }
          ],
          "why": "加工進捗度は、加工が進んだ割合。残りの割合ではなく、進捗度そのものをかける。"
        }
      ],
      "ref": {
        "topic": "K08",
        "anchor": "equivalent"
      },
      "needs_review": false
